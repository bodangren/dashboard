+  cursor: pointer;
+}
+
+.search-result-item:hover {
+  background: var(--bg);
+}
+
+.search-result-item:last-child {
+  border-bottom: none;
+}
+
+.search-result-hash {
+  font-family: var(--font-mono);
+  color: var(--green);
+  font-size: 0.85rem;
+  margin-right: 0.5rem;
+}
+
+.search-result-message {
