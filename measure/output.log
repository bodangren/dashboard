+/* ── Search ── */
+.search-container {
+  display: flex;
+  gap: 0.5rem;
+  align-items: center;
+}
+
+.search-input {
+  background: var(--bg);
+  color: var(--text);
+  border: 2px solid var(--border);
+  padding: 0.5rem 0.75rem;
+  font-family: var(--font-mono);
+  font-size: 0.9rem;
+  width: 200px;
+}
+
+.search-input:focus {
+  border-color: var(--green);
+  outline: none;
+}
+
+.search-btn,
+.filter-toggle {
+  background: var(--bg);
+  color: var(--text);
+  border: 2px solid var(--border);
+  padding: 0.5rem;
+  cursor: pointer;
+}
+
+.search-btn:hover,
+.filter-toggle:hover,
+.filter-toggle.active {
+  border-color: var(--green);
+  color: var(--green);
+}
+
+.filter-panel {
+  background: var(--bg-card);
+  border: 2px solid var(--border);
+  border-top: none;
+  padding: 1rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+
+.filter-panel.hidden {
+  display: none;
+}
+
+.filter-row {
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+}
+
+.filter-row label {
+  font-size: 0.85rem;
+  color: var(--text-dim);
+  font-weight: 600;
+}
+
+.filter-select,
+.filter-input {
+  background: var(--bg);
+  color: var(--text);
+  border: 2px solid var(--border);
+  padding: 0.4rem 0.6rem;
+  font-size: 0.85rem;
+}
+
+.filter-select:focus,
+.filter-input:focus {
+  border-color: var(--green);
+  outline: none;
+}
+
+/* ── Search Results ── */
